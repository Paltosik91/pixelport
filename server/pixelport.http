@host = http://localhost:5080

### Весь каталог (по рейтингу)
GET {{host}}/api/games

### Поиск и фильтры: гонки со скидкой, дешевле 1000 ₽, сначала дешёвые
GET {{host}}/api/games?genre=Гонки&onlySale=true&maxPrice=1000&sort=price-asc

### Поиск по названию
GET {{host}}/api/games?q=neon

### Неизвестная сортировка → 400
GET {{host}}/api/games?sort=cheap

### Цена не числом → 400
GET {{host}}/api/games?maxPrice=дёшево

### Одна игра
GET {{host}}/api/games/3

### Такой игры нет → 404
GET {{host}}/api/games/999

### id не число → 404 (маршрут не подошёл)
GET {{host}}/api/games/neon

### Жанры с количеством игр
GET {{host}}/api/genres

### Статистика продаж → 200: итоги, жанры, топ-5
GET {{host}}/api/stats

### Похожие на Hollow Bell → 200, три игры, Polar Signal первой
GET {{host}}/api/games/9/similar

### Похожие на Iron Harbor → 200, одна игра
GET {{host}}/api/games/4/similar

### Похожие на несуществующую игру → 404
GET {{host}}/api/games/999/similar

### Новая игра → 201
POST {{host}}/api/games
Content-Type: application/json

{
  "title": "Starlight Courier",
  "slug": "starlight-courier",
  "genre": "Приключения",
  "developer": "Comet Post",
  "releaseYear": 2026,
  "price": 899,
  "discountPercent": 10,
  "description": "Развозите письма между планетами на маленьком почтовом корабле."
}

### Всё неправильно → 400 с ошибкой у каждого поля
POST {{host}}/api/games
Content-Type: application/json

{
  "title": "X",
  "slug": "Моя Игра",
  "genre": "Шутер",
  "developer": "",
  "releaseYear": 1900,
  "price": -5,
  "discountPercent": 95,
  "description": "коротко"
}

### Скидка 75% на Neon Circuit → 200
PUT {{host}}/api/games/3/discount
Content-Type: application/json

{ "discountPercent": 75 }

### Скидка 95% → 400
PUT {{host}}/api/games/3/discount
Content-Type: application/json

{ "discountPercent": 95 }

### Изменить игру целиком → 200 (id новой игры поставь свой)
PUT {{host}}/api/games/13
Content-Type: application/json

{
  "title": "Starlight Courier: Deluxe",
  "slug": "starlight-courier",
  "genre": "Приключения",
  "developer": "Comet Post",
  "releaseYear": 2026,
  "price": 1299,
  "discountPercent": 0,
  "description": "Развозите письма между планетами, теперь с грузовым отсеком."
}

### Выбор редакции: только подборка → 200, Iron Harbor, Lantern Valley, Hollow Bell
GET {{host}}/api/games?editorsChoice=true

### Выбор редакции вместе с жанром → 200, только Iron Harbor
GET {{host}}/api/games?editorsChoice=true&genre=Стратегии

### Добавить Neon Circuit в подборку → 200, "isEditorsChoice": true
PUT {{host}}/api/games/3/editors-choice
Content-Type: application/json

{ "isEditorsChoice": true }

### Убрать обратно → 200, "isEditorsChoice": false
PUT {{host}}/api/games/3/editors-choice
Content-Type: application/json

{ "isEditorsChoice": false }

### Без поля → 400
PUT {{host}}/api/games/3/editors-choice
Content-Type: application/json

{ }

### Нет такой игры → 404
PUT {{host}}/api/games/999/editors-choice
Content-Type: application/json

{ "isEditorsChoice": true }

### Удалить игру с отзывами → 409
DELETE {{host}}/api/games/3

### Удалить игру без отзывов → 204, повторно → 404
DELETE {{host}}/api/games/13

### Игроки для переключателя «Играю как…»
GET {{host}}/api/players

### Отзывы на Neon Circuit, новые сверху
GET {{host}}/api/games/3/reviews

### Новый отзыв → 201 (BearPaw ещё не писал о Neon Circuit)
POST {{host}}/api/games/3/reviews
Content-Type: application/json

{ "playerId": 2, "isRecommended": false, "text": "Слишком быстро для меня, укачало." }

### Тот же игрок второй раз → 500 (а в квесте ★★★ — 409)
POST {{host}}/api/games/3/reviews
Content-Type: application/json

{ "playerId": 2, "isRecommended": true, "text": "Передумал, всё-таки отличная игра!" }

### Короткий текст и несуществующий игрок → 400 с двумя ошибками
POST {{host}}/api/games/3/reviews
Content-Type: application/json

{ "playerId": 99, "isRecommended": true, "text": "ок" }

### Отзыв на несуществующую игру → 404
POST {{host}}/api/games/999/reviews
Content-Type: application/json

{ "playerId": 1, "isRecommended": true, "text": "Такой игры нет, но отзыв хочется" }

### Заказ: Nova покупает Orbital Echo и Lantern Valley с промокодом → 201
POST {{host}}/api/orders
Content-Type: application/json

{ "playerId": 1, "gameIds": [1, 6], "promoCode": "pixel10" }

### Ещё раз Lantern Valley → 409
POST {{host}}/api/orders
Content-Type: application/json

{ "playerId": 1, "gameIds": [6, 3] }

### Пустая корзина и чужой промокод → 400 с двумя ошибками
POST {{host}}/api/orders
Content-Type: application/json

{ "playerId": 1, "gameIds": [], "promoCode": "FREE" }

### Цену прислать нельзя: лишнее поле сервер не читает → 201, а total посчитан по базе
POST {{host}}/api/orders
Content-Type: application/json

{ "playerId": 2, "gameIds": [3], "total": 1 }

### Библиотека Nova → 200, две игры
GET {{host}}/api/players/1/library

### Библиотека несуществующего игрока → 404
GET {{host}}/api/players/99/library

### Файлы сервера наружу не отдаются
GET {{host}}/server/appsettings.json

### Игра без обязательных полей → 400
POST {{host}}/api/games
Content-Type: application/json

{ "title": "Моя игра" }
